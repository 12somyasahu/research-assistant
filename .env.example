# ============================================================
# Multi-Agent Research Assistant — Environment Variables
# Copy this file to .env and fill in your actual keys
# Get GROQ API key: https://console.groq.com/keys (free tier available)
# Get Tavily API key: https://app.tavily.com (free tier = 1000 req/month)
# ============================================================

GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
# Optional: choose Groq model (defaults to openai/gpt-oss-120b, or use openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: switch to OpenAI if you want (update model names in agents too)
# OPENAI_API_KEY=your_openai_api_key_here
